# 统一换行：源码用 LF，Windows 脚本用 CRLF
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.webp  binary
*.db    binary
*.zip   binary
*.exe   binary
